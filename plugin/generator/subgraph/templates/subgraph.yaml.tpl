# Code generated by protoc-gen-web3. DO NOT EDIT.
# The Graph manifest for {{.Database}}. Set each dataSource's network, address,
# and startBlock after deploying the storage contracts.
specVersion: {{.SpecVersion}}
schema:
  file: ./schema.graphql
dataSources:
{{- range .Sources}}
  - kind: ethereum/contract
    name: {{.Name}}
    network: mainnet
    source:
      abi: {{.Contract}}
      address: "0x0000000000000000000000000000000000000000"
      startBlock: 0
    mapping:
      kind: ethereum/events
      apiVersion: {{$.APIVersion}}
      language: wasm/assemblyscript
      file: ./src/{{.MappingPkg}}.ts
      entities:
        - {{.Name}}
      abis:
        - name: {{.Contract}}
          file: ./abis/{{.Contract}}.json
      eventHandlers:
        - event: {{.Name}}Created({{.KeySig}})
          handler: handle{{.Name}}Created
        - event: {{.Name}}Updated({{.KeySig}})
          handler: handle{{.Name}}Updated
        - event: {{.Name}}Deleted({{.KeySig}})
          handler: handle{{.Name}}Deleted
{{- end}}
