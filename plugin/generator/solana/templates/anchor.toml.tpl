# {{.Database}} — Anchor workspace generated by protoc-gen-web3. DO NOT EDIT.
# Run `anchor keys sync` to bind real program ids, then `anchor build`.
[toolchain]
anchor_version = "{{.AnchorVersion}}"

[features]
resolution = true
skip-lint = false

[programs.localnet]
{{- range .Programs}}
{{.}} = "{{$.ProgramID}}"
{{- end}}

[registry]
url = "https://api.apr.dev"

[provider]
cluster = "localnet"
wallet = "~/.config/solana/id.json"

[scripts]
test = "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts"
